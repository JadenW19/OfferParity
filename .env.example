# Optional default Slack Incoming Webhook URL (must start with https://hooks.slack.com/services/)
SLACK_WEBHOOK_URL=

# Optional Slack Incoming Webhook URL for inbound lead notifications from POST /api/leads
LEAD_ALERT_SLACK_WEBHOOK_URL=

# Optional per-IP requests per minute override for POST /api/xray (default: 30)
RATE_LIMIT_RPM=30

# Optional public app URL for OpenGraph / shareable link metadata (e.g. https://offerparity.app)
NEXT_PUBLIC_APP_URL=https://offerparity.app

# Optional Stripe Payment Links for instant $99/mo Growth and $249/mo Agency upgrades
NEXT_PUBLIC_STRIPE_GROWTH_LINK=
NEXT_PUBLIC_STRIPE_AGENCY_LINK=

# Optional PostHog analytics (client-side funnel tracking)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
